# Public storefront settings used at build time (safe to commit: these values
# are embedded in the browser bundle anyway). Secrets stay in Vercel env vars.
VITE_STORE_NAME="Moustapha Phone"
VITE_STORE_SLUG="moustapha-phone"
VITE_STORE_TAGLINE="Smartphones & accessoires au Maroc"
VITE_STORE_DESCRIPTION="Smartphones, coques et accessoires originaux avec livraison partout au Maroc et paiement à la livraison."
VITE_SITE_URL="https://moustapha-phone.vercel.app"
VITE_SUPPORT_HOURS="7j/7 de 9h à 21h"
# VITE_WHATSAPP_NUMBER="2126XXXXXXXX"  — add the client's real number
# VITE_WHATSAPP_DISPLAY="+212 6XX XXX XXX"
